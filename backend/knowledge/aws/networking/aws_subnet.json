{
  "schema_version": "1.0.0",
  "resource_type": "aws_subnet",
  "display_name": "VPC Subnet",
  "category": "networking",
  "description": "A range of IP addresses within a designated Availability Zone in your VPC.",
  "sections": [
    {
      "id": "general",
      "title": "Subnet Configuration",
      "description": "VPC attachment, CIDR assignment, and Availability Zone placement",
      "fields": [
        {
          "id": "subnet_vpc_id",
          "var_name": "vpc_id",
          "label": "Parent VPC ID",
          "ui_component": "text",
          "importance": "required",
          "visibility": "basic",
          "default": {
            "value": "",
            "source": "user"
          },
          "terraform": {
            "resource": "aws_subnet",
            "argument": "vpc_id"
          },
          "why": "Associates this subnet slice with an existing parent VPC.",
          "impact": "Changing VPC ID forces destruction and re-creation of the subnet.",
          "learn_more": "https://docs.aws.amazon.com/vpc/latest/userguide/configure-subnets.html"
        },
        {
          "id": "subnet_cidr_block",
          "var_name": "cidr_block",
          "label": "Subnet CIDR Block",
          "ui_component": "cidr",
          "importance": "required",
          "visibility": "basic",
          "default": {
            "value": "10.0.1.0/24",
            "source": "user"
          },
          "validation": {
            "regex": "^(([0-9]{1,3}\\.){3}[0-9]{1,3})\\/(1[6-9]|2[0-8])$",
            "error_message": "Must be a valid IPv4 CIDR range contained within the parent VPC CIDR."
          },
          "terraform": {
            "resource": "aws_subnet",
            "argument": "cidr_block"
          },
          "why": "Allocates a subset of the parent VPC address space exclusively to this subnet.",
          "impact": "Cannot overlap with existing subnet CIDR blocks in the same VPC.",
          "learn_more": "https://docs.aws.amazon.com/vpc/latest/userguide/configure-subnets.html#subnet-sizing-ipv4"
        },
        {
          "id": "subnet_availability_zone",
          "var_name": "availability_zone",
          "label": "Availability Zone",
          "ui_component": "select",
          "options": [
            { "label": "us-east-1a", "value": "us-east-1a" },
            { "label": "us-east-1b", "value": "us-east-1b" },
            { "label": "us-east-1c", "value": "us-east-1c" }
          ],
          "importance": "required",
          "visibility": "basic",
          "default": {
            "value": "us-east-1a",
            "source": "user"
          },
          "terraform": {
            "resource": "aws_subnet",
            "argument": "availability_zone"
          },
          "why": "Pins this subnet to a physically isolated AWS data center location.",
          "impact": "Deploying subnets across multiple AZs guarantees high availability.",
          "learn_more": "https://docs.aws.amazon.com/global-infrastructure/latest/regions/availability-zones.html"
        },
        {
          "id": "subnet_map_public_ip_on_launch",
          "var_name": "map_public_ip_on_launch",
          "label": "Auto-assign Public IP on Launch",
          "ui_component": "switch",
          "importance": "optional",
          "visibility": "basic",
          "default": {
            "value": false,
            "source": "aws"
          },
          "recommended": {
            "development": false,
            "production": false
          },
          "terraform": {
            "resource": "aws_subnet",
            "argument": "map_public_ip_on_launch"
          },
          "why": "Automatically assigns public IPs to ENIs created inside this subnet (used for Public Subnets).",
          "impact": "Keep disabled for Private Subnets housing database or compute instances.",
          "learn_more": "https://docs.aws.amazon.com/vpc/latest/userguide/vpc-ip-addressing.html#subnet-public-ip"
        }
      ]
    }
  ]
}
