{
  "schema_version": "1.0.0",
  "resource_type": "aws_secretsmanager_secret",
  "display_name": "Secrets Manager Secret",
  "category": "security",
  "description": "Secure container for storing sensitive API keys, database credentials, and certificates.",
  "sections": [
    {
      "id": "general",
      "title": "Secret Container",
      "description": "Naming and KMS key binding",
      "fields": [
        {
          "id": "secret_name",
          "var_name": "secret_name",
          "label": "Secret Name",
          "ui_component": "text",
          "importance": "required",
          "visibility": "basic",
          "default": {
            "value": "app-api-credentials",
            "source": "dopa_recommended"
          },
          "validation": {
            "regex": "^[a-zA-Z0-9/_+=.@-]{1,512}$",
            "error_message": "1 to 512 characters. Alphanumeric, slash, underscore, plus, equal, period, hyphen allowed."
          },
          "terraform": {
            "resource": "aws_secretsmanager_secret",
            "argument": "name"
          },
          "why": "Identifies the secret path used by applications and IAM access policies.",
          "impact": "Changing secret name forces resource replacement.",
          "learn_more": "https://docs.aws.amazon.com/secretsmanager/latest/userguide/manage_create-secrets.html"
        }
      ]
    }
  ]
}
