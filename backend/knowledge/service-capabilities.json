[
  {
    "service": "cloudfront",
    "provider": "aws",
    "category": "cdn",
    "logical_component": "cdn",
    "best_for": ["global_static_delivery", "edge_caching", "tls_termination"],
    "avoid_when": ["internal_only_workloads"],
    "cost_level": "low",
    "complexity": "low",
    "scalability": "very_high",
    "managed": true,
    "dependencies": ["route53_optional"],
    "exposed_fields": ["enabled", "aliases", "default_root_object", "price_class", "viewer_certificate"],
    "hidden_fields": ["origin_shield", "lambda_function_associations", "response_headers_policy_id"],
    "default_settings": { "price_class": "PriceClass_100", "enabled": true }
  },
  {
    "service": "alb",
    "provider": "aws",
    "category": "load_balancer",
    "logical_component": "load_balancer",
    "best_for": ["http_https_routing", "path_based_routing", "container_apps"],
    "avoid_when": ["pure_tcp_passthrough"],
    "cost_level": "low_to_medium",
    "complexity": "low",
    "scalability": "high",
    "managed": true,
    "dependencies": ["vpc", "subnets", "security_group"],
    "exposed_fields": ["internal", "subnet_ids", "security_groups", "target_type", "listener_ports"],
    "hidden_fields": ["access_logs", "waf_association", "idle_timeout"],
    "default_settings": { "internal": false, "target_type": "ip" }
  },
  {
    "service": "ecs",
    "provider": "aws",
    "category": "compute",
    "logical_component": "compute",
    "best_for": ["microservices", "webapps", "batch_workers"],
    "avoid_when": ["full_kubernetes_platform_needs"],
    "cost_level": "medium",
    "complexity": "medium",
    "scalability": "high",
    "managed": true,
    "dependencies": ["vpc", "subnets", "iam_role", "cloudwatch"],
    "exposed_fields": ["launch_type", "desired_count", "cpu", "memory", "platform_version", "task_definition"],
    "hidden_fields": ["capacity_provider_strategy", "service_registries", "deployment_circuit_breaker"],
    "default_settings": { "launch_type": "FARGATE", "desired_count": 2 }
  },
  {
    "service": "eks",
    "provider": "aws",
    "category": "compute",
    "logical_component": "compute",
    "best_for": ["platform_teams", "complex_microservices", "custom_runtime_needs"],
    "avoid_when": ["small_team_simple_ops"],
    "cost_level": "high",
    "complexity": "high",
    "scalability": "very_high",
    "managed": true,
    "dependencies": ["vpc", "subnets", "node_groups", "iam_roles"],
    "exposed_fields": ["cluster_version", "endpoint_public_access", "node_group_size", "subnet_ids"],
    "hidden_fields": ["kubernetes_addons", "oidc_provider", "fargate_profiles"],
    "default_settings": { "endpoint_public_access": false }
  },
  {
    "service": "rds",
    "provider": "aws",
    "category": "database",
    "logical_component": "database",
    "best_for": ["relational_workloads", "transactional_apps", "simple_operational_model"],
    "avoid_when": ["massive_unstructured_key_value_access"],
    "cost_level": "medium",
    "complexity": "medium",
    "scalability": "high",
    "managed": true,
    "dependencies": ["subnets", "security_group", "kms_optional"],
    "exposed_fields": ["engine", "instance_class", "allocated_storage", "multi_az", "storage_encrypted"],
    "hidden_fields": ["backup_retention_period", "performance_insights_enabled", "deletion_protection"],
    "default_settings": { "multi_az": true, "storage_encrypted": true }
  },
  {
    "service": "aurora",
    "provider": "aws",
    "category": "database",
    "logical_component": "database",
    "best_for": ["scalable_relational_workloads", "read_heavy_apps", "high_availability"],
    "avoid_when": ["lowest_possible_cost"],
    "cost_level": "high",
    "complexity": "medium",
    "scalability": "very_high",
    "managed": true,
    "dependencies": ["subnets", "security_group", "kms"],
    "exposed_fields": ["engine_mode", "engine_version", "instance_class", "serverlessv2_scaling_configuration", "backup_retention_period"],
    "hidden_fields": ["global_cluster_identifier", "availability_zones", "copy_tags_to_snapshot"],
    "default_settings": { "engine_mode": "provisioned", "storage_encrypted": true }
  },
  {
    "service": "redis",
    "provider": "aws",
    "category": "cache",
    "logical_component": "cache",
    "best_for": ["session_storage", "hot_data_cache", "rate_limiting"],
    "avoid_when": ["persistent_primary_datastore"],
    "cost_level": "medium",
    "complexity": "medium",
    "scalability": "high",
    "managed": true,
    "dependencies": ["subnets", "security_group"],
    "exposed_fields": ["node_type", "num_cache_clusters", "multi_az_enabled", "transit_encryption_enabled"],
    "hidden_fields": ["automatic_failover_enabled", "snapshot_retention_limit"],
    "default_settings": { "multi_az_enabled": true, "transit_encryption_enabled": true }
  }
]