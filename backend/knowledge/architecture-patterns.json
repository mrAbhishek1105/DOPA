[
  {
    "pattern_id": "global_realtime_platform",
    "name": "Global Real-Time Platform",
    "description": "Globally distributed, latency-sensitive workloads such as feeds, chat, and live collaboration.",
    "workload_type": "social_media",
    "conditions": {
      "application_type": ["social_media", "chat", "ecommerce"],
      "traffic": "very_high",
      "users": ">1000000",
      "availability": "multi_region",
      "latency_sla": "<200ms"
    },
    "logical_components": ["cdn", "load_balancer", "compute", "database", "cache", "search", "object_storage"],
    "default_services": ["cloudfront", "alb", "eks", "aurora", "redis", "opensearch", "s3"],
    "recommended_characteristics": {
      "compute": "horizontal_scaling",
      "data": "multi_az",
      "network": "global_edge_presence"
    },
    "tags": ["global", "realtime", "high-scale", "low-latency"]
  },
  {
