      "cdn"
    ]
  },
  "media_storage": {
    "possible_values": [
      "low", "medium", "high"
    ],
    "affects": [
      "s3",
      "cloudfront"
    ]
  },
  "compliance": {
    "possible_values": [
      "none", "soc2", "hipaa", "pci"
    ],
    "affects": [
